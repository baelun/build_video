# 複製為 .env 後填入。.env 已列入 .gitignore，不會提交。

# xAI (Grok) API key；mock 模式不需要
XAI_API_KEY=

# 製作專案存放位置（預設 ./projects）
# STORYBOOK_PROJECTS_DIR=./projects

# xAI 模型與參數（可覆寫專案預設值；名稱請以 https://docs.x.ai 當前文件為準）
# XAI_TEXT_MODEL=            # 分鏡用文字模型，未設定時 xai 分鏡會直接報錯
# XAI_IMAGE_MODEL=grok-imagine-image-2.0
# XAI_VIDEO_MODEL=grok-imagine-video-1.5
# XAI_VIDEO_RESOLUTION=720p
